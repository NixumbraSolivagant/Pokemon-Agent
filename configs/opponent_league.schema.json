{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opponent League Registry",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": 2},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "status"],
        "properties": {
          "source_id": {"type": "string"},
          "team_id": {"type": "integer"},
          "submission_id": {"type": "integer"},
          "rank": {"type": "integer"},
          "score": {"type": "number"},
          "status": {"enum": ["qualified", "rejected", "pending"]},
          "package": {"type": "string"},
          "package_sha256": {"type": "string"},
          "deck_sha256": {"type": "string"},
          "decisions": {"type": "integer"},
          "clone_algorithm_version": {"type": "integer"},
          "profile": {"type": "string"},
          "audit": {"type": "object"},
          "quality_gate": {"type": "object"},
          "profile_attempts": {"type": "array"}
        }
      }
    }
  }
}
